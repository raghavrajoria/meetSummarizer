# Explicit public LOCAL PRE-COMPUTED DEMO. Credentials apply only locally.
DEMO=true
APP_ENV=demo
ASR_MODE=import
POSTGRES_PASSWORD=local-demo-password
DATABASE_URL=postgresql://indicmeet:local-demo-password@db:5432/indicmeet
S3_ACCESS_KEY=local-demo
S3_SECRET_KEY=local-demo-storage-password
MEDIA_SIGNING_SECRET=local-demo-signing-secret-change-before-hosting

DEMO_PRECOMPUTED_ONLY=true
COMPOSE_PROJECT_NAME=indicmeet-precomputed
